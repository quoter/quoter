{
  "name": "quoter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun run --cwd apps/bot start",
    "deploy-commands": "bun run --cwd apps/bot deploy-commands",
    "typecheck": "bun run --cwd apps/bot typecheck",
    "test": "bun test apps/bot/test",
    "build": "bun run --cwd apps/bot build",
    "build:release": "bun run --cwd apps/bot build:release",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "lefthook": "^2.1.14",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "catalog:",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.0"
}
