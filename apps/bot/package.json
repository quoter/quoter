{
  "name": "@quoter/bot",
  "version": "5.2.1",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "deploy-commands": "bun run src/lib/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "build:release": "bun run scripts/build.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate:mongo": "bun run src/migration/mongo-to-sqlite.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.95",
    "bufferutil": "^4.1.0",
    "canvas-multiline-text": "1.0.3",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.1.0",
    "mongodb": "^7.5.0",
    "ms": "^2.1.3",
    "utf-8-validate": "^6.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/canvas-multiline-text": "^1.0.2",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
