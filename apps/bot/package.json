	"repository": {
		"type": "git",
		"url": "git+https://github.com/quoter/quoter.git"
	},
	"dependencies": {
		"@napi-rs/canvas": "0.1.95",
		"bufferutil": "^4.1.0",
		"canvas-multiline-text": "1.0.3",
		"discord.js": "^14.25.1",
		"fuse.js": "^7.1.0",
		"mongoose": "^9.2.3",
		"ms": "^2.1.3",
		"utf-8-validate": "^6.0.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/canvas-multiline-text": "^1.0.2",
		"@types/ms": "^2.1.0",
		"typescript": "catalog:"
	}
}
