# Discord Bot Token
DISCORD_TOKEN=

# [Optional] SQLite database file
DATABASE_PATH=./db/quoter.sqlite

# [Optional] IDs of users that should bypass cooldowns. Seperate multiple IDs with a space.
DISCORD_ADMIN_ID=

# [Optional] ID of guild to register commands to instead of globally. Use in development.
DISCORD_GUILD_ID=

# [Optional] Maximum quotes per guild. Can be changed per guild by setting max_quotes in the guilds table.
MAX_GUILD_QUOTES=2500

# [Optional] Maximum characters per quote.
MAX_QUOTE_LENGTH=250

# [Optional] Days to retain data after Quoter last sees a guild.
GUILD_RETENTION_DAYS=30

# [Optional] Set by release builds. Local development uses "development".
BUILD_SHA=development
